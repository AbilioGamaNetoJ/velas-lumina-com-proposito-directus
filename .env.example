# Copie este arquivo para .env.local e preencha com valores reais.
# .env.local nunca é commitado (veja .gitignore).

# URL pública da instância Directus (sem barra final)
NEXT_PUBLIC_DIRECTUS_URL=https://seu-directus.exemplo.com.br

# OPCIONAL. Sem essa variável, as leituras dependem da role Public do
# Directus (já configurada com acesso em products/categories/site_settings/
# faqs/privacy_policy/directus_files). Só é necessária localmente para rodar
# scripts/setup-directus-content.mjs (nesse caso, use um token admin) —
# nunca coloque um token admin em produção/Vercel.
DIRECTUS_TOKEN=

# URL base do site, usada em metadataBase e OG/canonical
SITE_URL=http://localhost:3001

# O projeto funciona mesmo sem essas variáveis: cada lib/directus/get-*.ts
# cai automaticamente no catálogo/copy estático (lib/data.ts e afins) quando
# NEXT_PUBLIC_DIRECTUS_URL não está definida ou a chamada ao Directus falha.
